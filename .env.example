# --- Mode ---
# Set to 1 to replace Twilio and Retell with local mock providers (no credentials needed,
# nothing is sent, every response is labeled "mock": true).
RINGTASK_MOCK=0

# --- Server ---
API_PORT=3210
DATABASE_URL=ringtask.db
# Public base URL of this API (used to validate Twilio webhook signatures)
BASE_URL=https://your-public-host.example.com
# Required to call POST /api/admin/create-agent; leave empty to disable that route
ADMIN_API_KEY=

# --- Number pool ---
DEFAULT_ASSIGN_HOURS=4
MAX_ASSIGN_HOURS=168
COOLDOWN_HOURS=24
NEW_USER_CREDITS=100

# --- Twilio (SMS + phone numbers) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Comma-separated E.164 numbers you own in Twilio; they form the pool
TWILIO_PHONE_NUMBERS=
TWILIO_VALIDATE_WEBHOOKS=true

# --- Retell (AI voice calls) ---
RETELL_API_KEY=
RETELL_AGENT_ID=
# Where Retell should POST call events: https://<BASE_URL>/api/webhooks/retell
RETELL_WEBHOOK_URL=

# --- Stripe (credit purchases) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Solana (experimental credit purchases) ---
SOLANA_RPC_URL=
SOLANA_TREASURY_ADDRESS=
SOL_PRICE_USD=150

# --- MCP server ---
# API key (from POST /api/auth/register) of the user the MCP tools act as.
# May be empty when RINGTASK_MOCK=1; a local demo user is used instead.
RINGTASK_API_KEY=
